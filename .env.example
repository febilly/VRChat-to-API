# ============================================================================
# Soniox STT — provide EITHER a permanent key OR a temp-key dispenser URL.
# ============================================================================
# Permanent key (takes priority if set):
# SONIOX_API_KEY=your_permanent_key

# Temp-key dispenser (the app fetches a fresh ephemeral key per stream):
# SONIOX_TEMP_KEY_URL=https://dispenser.example.xyz
# Optional headers for the dispenser request (JSON object):
# SONIOX_TEMP_KEY_HEADERS={"Authorization": "Bearer xxxxx"}

# Soniox websocket endpoint (region-specific options exist, e.g. stt-rt.jp.soniox.com):
# SONIOX_WEBSOCKET_URL=wss://stt-rt.soniox.com/transcribe-websocket

# Seamless stream rollover: temp-key streams have a hard lifetime. Set the
# per-stream duration (seconds) to proactively warm + switch to a fresh stream
# without interrupting recognition. Leave unset to disable.
# SONIOX_STREAM_DURATION_SECONDS=170

# Optional cost saver: sleep the stream on long silence, wake on speech.
# SONIOX_SLEEP_ON_SILENCE=false
# SONIOX_SLEEP_IDLE_SECONDS=30

# Speaker diarization (off by default; system loopback already excludes your mic).
# ENABLE_SPEAKER_DIARIZATION=false

# Soniox language hints (comma-separated ISO 639-1):
# LANGUAGE_HINTS=en,zh,ja,ko,ru

# ============================================================================
# Audio capture
# ============================================================================
# system | microphone | mix. "system" loopback captures only others' voices.
# AUDIO_SOURCE=system
# To isolate VRChat only: route VRChat output to a dedicated/virtual output
# device, then point loopback at it by (partial) name:
# LOOPBACK_DEVICE_NAME=CABLE Input
# Mix gains (only when AUDIO_SOURCE=mix); self=mic, others=system:
# MIX_OWN_VOLUME=0.5

# ============================================================================
# VRChat OSC (chatbox)
# ============================================================================
# VRCHAT_OSC_HOST=127.0.0.1
# VRCHAT_OSC_PORT=9000
# Long prompts are paged by punctuation and cycled in the chatbox until the
# reply returns. Per-page dwell = max(MIN, cjk/CJK_CPS + other/LATIN_CPS):
# CHATBOX_CJK_CPS=6
# CHATBOX_LATIN_CPS=15
# CHATBOX_MIN_PAGE_SECONDS=3
# CHATBOX_MAX_PAGE_SECONDS=

# ============================================================================
# Reply capture — when the spoken reply is considered finished
# ============================================================================
# Reply done = endpoint detected AND silence >= MIN_SILENCE. Capped at MAX_WAIT.
# CAPTURE_MIN_SILENCE_SECONDS=1.5
# CAPTURE_MAX_WAIT_SECONDS=45
# CAPTURE_NO_REPLY_MESSAGE=（对方没有回复）
# Safety net: if Soniox never fires an endpoint, complete once silence after
# speech reaches this many seconds (prevents waiting all the way to MAX_WAIT).
# CAPTURE_SILENCE_FALLBACK_SECONDS=4
# How long to wait for the on-demand STT stream to connect when a request starts.
# ENGINE_START_TIMEOUT_SECONDS=12

# ============================================================================
# OpenAI-compatible API server
# ============================================================================
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8080
# MODEL_NAME=vrchat-human

# ============================================================================
# Floating overlay window (always-on-top live recognition + status)
# ============================================================================
# Set false to run headless (no window). Close the window to quit the app.
# SHOW_OVERLAY=true
# OVERLAY_OPACITY=0.92
