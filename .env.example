# ============================================================================
# Soniox STT — provide EITHER a permanent key OR a temp-key dispenser URL.
# ============================================================================
# Permanent key (takes priority if set):
# SONIOX_API_KEY=your_permanent_key

# Temp-key dispenser (the app fetches a fresh ephemeral key per stream):
# SONIOX_TEMP_KEY_URL=https://dispenser.example.xyz
# Optional headers for the dispenser request (JSON object):
# SONIOX_TEMP_KEY_HEADERS={"Authorization": "Bearer xxxxx"}

# Soniox websocket endpoint (region-specific options exist, e.g. stt-rt.jp.soniox.com):
# SONIOX_WEBSOCKET_URL=wss://stt-rt.soniox.com/transcribe-websocket

# Seamless stream rollover: temp-key streams have a hard lifetime. Set the
# per-stream duration (seconds) to proactively warm + switch to a fresh stream
# without interrupting recognition. Leave unset to disable.
# SONIOX_STREAM_DURATION_SECONDS=170

# Optional cost saver: sleep the stream on long silence, wake on speech.
# SONIOX_SLEEP_ON_SILENCE=false
# SONIOX_SLEEP_IDLE_SECONDS=30

# Speaker diarization (off by default; system loopback already excludes your mic).
# ENABLE_SPEAKER_DIARIZATION=false

# Soniox language hints (comma-separated ISO 639-1):
# LANGUAGE_HINTS=en,zh,ja,ko,ru

# ============================================================================
# Audio capture
# ============================================================================
# system | microphone | mix. "system" loopback captures only others' voices.
# AUDIO_SOURCE=system
# To isolate VRChat only: route VRChat output to a dedicated/virtual output
# device, then point loopback at it by (partial) name:
# LOOPBACK_DEVICE_NAME=CABLE Input
# Mix gains (only when AUDIO_SOURCE=mix); self=mic, others=system:
# MIX_OWN_VOLUME=0.5

# ============================================================================
# VRChat OSC (chatbox)
# ============================================================================
# VRCHAT_OSC_HOST=127.0.0.1
# VRCHAT_OSC_PORT=9000
# Long prompts are paged by punctuation and cycled in the chatbox until the
# reply returns. Per-page dwell = max(MIN, cjk/CJK_CPS + other/LATIN_CPS):
# CHATBOX_CJK_CPS=6
# CHATBOX_LATIN_CPS=15
# CHATBOX_MIN_PAGE_SECONDS=3
# CHATBOX_MAX_PAGE_SECONDS=
# Re-send the current chatbox frame while listening so VRChat does not hide it.
# Values above 20 are capped to 20.
# CHATBOX_KEEPALIVE_SECONDS=20

# ============================================================================
# Reply capture — when the spoken reply is considered finished
# ============================================================================
# Reply done = endpoint detected AND silence >= MIN_SILENCE. Capped at MAX_WAIT.
# CAPTURE_MIN_SILENCE_SECONDS=1.5
# CAPTURE_MAX_WAIT_SECONDS=45
# CAPTURE_NO_REPLY_MESSAGE=（对方没有回复）
# Safety net: if Soniox never fires an endpoint, complete once silence after
# speech reaches this many seconds (prevents waiting all the way to MAX_WAIT).
# CAPTURE_SILENCE_FALLBACK_SECONDS=4
# How long to wait for the on-demand STT stream to connect when a request starts.
# ENGINE_START_TIMEOUT_SECONDS=12

# ============================================================================
# OpenAI-compatible API server
# ============================================================================
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8080
# MODEL_NAME=vrchat-human

# ============================================================================
# Floating overlay window (always-on-top live recognition + status)
# ============================================================================
# Set false to run headless (no window). Close the window to quit the app.
# SHOW_OVERLAY=true
# OVERLAY_OPACITY=0.92

# ============================================================================
# Tool calling (client-executed, standard OpenAI protocol)
# ============================================================================
# When on, a spoken reply that STARTS WITH a wake word is translated by a real
# LLM into structured tool_calls and returned to the caller. The caller executes
# the tool on ITS side and posts the result back — nothing runs on this host.
# ENABLE_TOOL_CALLING=false
# Spoken wake words that switch a reply into tool-call mode (comma-separated):
# TOOL_WAKE_WORDS=工具调用,tool calling
# Translator LLM (any OpenAI-compatible /chat/completions endpoint). Required
# when ENABLE_TOOL_CALLING=true, else tool calling auto-disables:
# TOOL_LLM_BASE_URL=https://api.openai.com/v1
# TOOL_LLM_API_KEY=sk-...
# TOOL_LLM_MODEL=gpt-4o-mini
# TOOL_LLM_TIMEOUT=20
# tool_choice for the translator. "auto" works everywhere (incl. DeepSeek
# thinking mode, which rejects "required"). Use "required" only if your model
# supports forcing a tool call. Auto-falls back to "auto" if the provider 400s.
# TOOL_LLM_TOOL_CHOICE=auto
# When the caller posts a tool result back, summarize it (via the translator)
# into a short line for the human. Off by default = send the raw result text
# (long results are paged + auto-cycled in the chatbox like any long prompt).
# ENABLE_TOOL_RESULT_SUMMARY=false

# ============================================================================
# Continue loop (keep an agent's tool loop alive across spoken turns)
# ============================================================================
# A plain text reply ends an agent's turn (it stops and waits for the typed
# user). With this on, a text-only spoken reply is returned as a tool_calls reply
# that invokes a harmless no-op tool (continue_session); the agent executes it,
# posts the result back, and we re-prompt the human — an infinite, human-paced
# loop. Say a stop word to break out. Requires the standalone MCP tool in
# ./mcp_continue_session/ to be registered with your agent (see its README).
# Works with ENABLE_TOOL_CALLING on or off (the call takes no arguments).
# ENABLE_CONTINUE_LOOP=false
# Name of the no-op tool. VRChat-to-API auto-detects the agent-advertised name
# from the request's tools list, so override only if your agent names it oddly.
# CONTINUE_TOOL_NAME=continue_session
# Spoken phrases that BREAK the loop (comma-separated):
# CONTINUE_STOP_WORDS=结束循环,停止循环,结束对话,exit loop,stop loop
# Chatbox prompt shown when the loop comes back around for the next turn:
# CONTINUE_PROMPT=（继续）请说下一步，或说"结束循环"停止
# Keep auto-continue alive when a turn times out with no speech:
# CONTINUE_ON_TIMEOUT=true

# ============================================================================
# Title-request interception
# ============================================================================
# Agent tools (Copilot, opencode, Claude Code, Codex, ...) fire background
# "title this conversation" requests. When matched, instantly return a canned
# title (fixed name + random chars) instead of bothering the human.
# INTERCEPT_TITLE_REQUESTS=true
# TITLE_TEXT=VRChat
# TITLE_RANDOM_LEN=6
# Comma-separated lowercase substrings; a match marks a request as a title gen.
# Defaults are exact phrases verified from each tool's source (opencode,
# Copilot Chat, Claude Code, Cherry Studio). Some tools send NO title request
# to the model endpoint, so there's nothing to intercept: Codex (generated
# server-side) and CodeWhale / DeepSeek TUI (derived locally from the first
# message). Leave unset to use the built-in set; override only to add a tool.
# TITLE_REQUEST_PATTERNS=you are a title generator,ignoring instructions and without punctuation
